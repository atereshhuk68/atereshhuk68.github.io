{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "unicorn/no-abusive-eslint-disable": "off"
  },
  "ignorePatterns": ["dist/", ".astro/", "node_modules/"]
}
