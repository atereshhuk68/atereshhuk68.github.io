{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@layouts/*": ["src/layouts/*"],
			"@components/*": ["src/components/*"],
			"@assets/*": ["src/assets/*"],
			"@hooks/*": ["src/hooks/*"],
			"@content/*": ["src/content/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	}
}
