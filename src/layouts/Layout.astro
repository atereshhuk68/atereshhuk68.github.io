---
import "@/styles/font.css";
import "@/styles/global.css";
import "@/styles/starwind.css";

import CookiePopup from "@/components/cookie-popup/CookiePopup.astro";
import ErrorDialog from "@/components/dialog/ErrorDialog.astro";
import SuccessDialog from "@/components/dialog/SuccessDialog.astro";
import Footer from "@/components/footer/Footer.astro";
import SpecialOffer from "@/components/forms/SpecialOffer.astro";
import Head from "@/components/head/Head.astro";
import { getISOLocale } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types";
import Header from "../components/header/Header.astro";

const { currentLocale } = Astro;

const { title, description } = Astro.props;

const ISOLocale = getISOLocale(currentLocale as Locales);
---

<!doctype html>
<html lang={ISOLocale} class="scroll-smooth min-h-full">
	<Head {title} {description} {currentLocale} />

	<body class="font-sans bg-shell-50 min-w-[360px] overflow-x-hidden grid grid-rows-[auto_1fr_auto] min-h-[100dvh] text-black-900" data-current-locale={currentLocale}>
		<Header />

		<main class="pb-20">
			<slot />
		</main>

		<Footer />

		<SpecialOffer />

		<SuccessDialog />

		<ErrorDialog />

		<CookiePopup />
	</body>
</html>

<script>
	(async () => {
		const [{ backgroundImageLazyLoader }, { scrollToViaUrl }] = await Promise.all([import('@/scripts/lazy-bg-loader'), import('@/scripts/scroll-to-via-url')]);

		backgroundImageLazyLoader.init();
		scrollToViaUrl.init();
	})();
</script>
