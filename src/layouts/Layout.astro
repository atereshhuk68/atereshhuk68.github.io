---
import "@/styles/global.css";
import "@/styles/starwind.css";

import CookiePopup from "@/components/cookie-popup/CookiePopup.astro";
import ErrorDialog from "@/components/dialog/ErrorDialog.astro";
import SuccessDialog from "@/components/dialog/SuccessDialog.astro";
import Footer from "@/components/footer/Footer.astro";
import SpecialOffer from "@/components/forms/SpecialOffer.astro";
import Head from "@/components/head/Head.astro";
import { getISOLocale } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types";
import Header from "../components/header/Header.astro";
import Breadcrumbs from "@/components/breadcrumbs/Breadcrumbs.astro";

const { currentLocale } = Astro;

interface Props {
  metaTitle: string;
  metaDescription: string;
}

const { metaTitle, metaDescription } = Astro.props;

const ISOLocale = getISOLocale(currentLocale as Locales);

const isHomePage = ["/", "/en/", "/uk/", "/ru/"].includes(Astro.url.pathname);
const is404Page = Astro.response.status === 404 || Astro.url.pathname === "/404";
---

<!doctype html>
<html lang={ISOLocale} class="min-h-full scroll-smooth">
  <Head {metaTitle} {metaDescription} {currentLocale} />

  <body
    class="bg-shell-50 text-black-900 grid min-h-dvh min-w-90 grid-rows-[auto_1fr_auto] overflow-x-hidden font-sans"
    data-current-locale={currentLocale}
  >
    <Header />

    <main class="pb-20">
      {!isHomePage && !is404Page && <Breadcrumbs />}

      <slot />
    </main>

    <Footer />

    {!is404Page && <SpecialOffer />}

    <SuccessDialog />

    <ErrorDialog />

    <CookiePopup />
  </body>
</html>

<script>
  (async () => {
    const [{ backgroundImageLazyLoader }, { scrollToViaUrl }] =
      await Promise.all([
        import("@/assets/ts/utils/lazy-bg-loader"),
        import("@/assets/ts/utils/scroll-to-via-url"),
      ]);

    backgroundImageLazyLoader.init();
    scrollToViaUrl.init();
  })();
</script>
