---
import "../styles/font.css";
import "../styles/global.css";

import CookiePopup from "@components/general/CookiePopup.astro";
import Footer from "@components/general/Footer/Footer.astro";
import Head from "@components/general/Head/Head.astro";
import Header from "../components/general/Header/Header.astro";

const currentLocale = Astro.currentLocale;

const { title, description } = Astro.props;
---

<!doctype html>
<html lang={currentLocale} class="scroll-smooth min-h-full">
	<Head {title} {description} />

	<body class="font-sans bg-shell-50 min-w-[360px] overflow-x-hidden grid grid-rows-[auto_1fr_auto] text-black-900">
		<Header />

		<main class="pb-20">
			<slot />
		</main>

		<Footer />

		<CookiePopup />
	</body>
</html>

<script>
	import { lazyBgLoader } from '../assets/ts/lazy-bg-loader';
	import { scrollToViaUrl } from '../assets/ts/scroll-to-via-url';
	lazyBgLoader.init();
	scrollToViaUrl.init();
</script>
