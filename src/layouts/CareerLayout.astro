---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';

type Props = CollectionEntry<'careers'>['data'];

const { title, description } = Astro.props;
---

<Layout>
	<div class="py-12">
		<div class="container">
			<article class="prose prose-lg mx-auto prose-headings:font-heading">
				<h1 class="font-heading text-5xl text-balance">{title}</h1>

				<p>{description}</p>

				<slot />
			</article>
		</div>
	</div>
</Layout>
