---
import { type CollectionEntry, getCollection } from 'astro:content';
import { render } from 'astro:content';
import CareerLayout from '@layouts/CareerLayout.astro';

export async function getStaticPaths() {
	const careers = await getCollection('careers');

	return careers.map((career) => {
		const [lang, ...slug] = career.slug.split('/');
		return {
			params: { lang, slug: slug.join('/') || undefined },
			props: career,
		};
	});
}

type Props = CollectionEntry<'careers'>;

const career = Astro.props;
const { Content } = await render(career);
---

<CareerLayout {...career.data}>
	<Content />
</CareerLayout>
