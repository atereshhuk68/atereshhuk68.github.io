---
import { getCollection } from 'astro:content';
import Layout from 'src/layouts/Layout.astro';
import { CareerCard } from '@components/Careers/CareerCard.tsx';
import type { CareerCardTypes } from 'src/types/types';
import { Languages } from '@i18n/langs';

const currentLang = Astro.params.lang;
const careers = await getCollection('careers', ({ slug }) => slug.startsWith(currentLang + '/'));

export async function getStaticPaths() {
	return Object.keys(Languages).map((lang) => {
		return {
			params: { lang },
		};
	});
}
---

<Layout>
	<div class="container py-12">
		<div class="text-center mb-12">
			<h1 class="font-heading text-4xl">Join Our Team</h1>
			<p class="text-lg text-pretty">We're looking for talented individuals to help us grow. Explore our open positions below.</p>
		</div>

		<div class="grid md:grid-cols-2 gap-8 max-w-screen-lg mx-auto">
			{
				careers.length > 0 ? (
					careers.map((career: CareerCardTypes) => {
						return <CareerCard {...career} />;
					})
				) : (
					<p class="col-span-full text-center text-default-500">No open positions available in this language currently.</p>
				)
			}
		</div>
	</div>
</Layout>
