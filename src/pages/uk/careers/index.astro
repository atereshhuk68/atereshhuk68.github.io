---
import Layout from "src/layouts/Layout.astro";
import CareerCard from "@/components/cards/CareerCard.astro";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { CareerCardType, Locales } from "@/types";

const { currentLocale = "pl" } = Astro;

const t = useTranslations(currentLocale as Locales);

const careers: CareerCardType[] = Object.values(
  import.meta.glob("./*.md", { eager: true }),
);

const title = t("career.heading");
const description = t("career.p");
---

<Layout {title} {description}>
  <div class="container py-12">
    <div class="mb-12 space-y-4 text-center">
      <h1 class="font-heading text-4xl">{t("career.heading")}</h1>
      <p class="text-lg text-pretty">{t("career.p")}</p>
    </div>

    <div class="mx-auto grid max-w-screen-lg gap-8 md:grid-cols-2">
      {
        careers.length > 0 ? (
          careers.map((career: CareerCardType) => <CareerCard {...career} />)
        ) : (
          <p class="text-default-500 col-span-full text-center">
            No open positions available currently.
          </p>
        )
      }
    </div>
  </div>
</Layout>
