---
import CareerCard from "@components/Careers/CareerCard.astro";
import { useTranslations } from "@i18n/utils";
import Layout from "src/layouts/Layout.astro";
import type { CareerCardType, Locales } from "src/types/types";

const { currentLocale = "pl" } = Astro;

const t = useTranslations(currentLocale as Locales);

const careers: CareerCardType[] = Object.values(
	import.meta.glob("./*.md", { eager: true }),
);

const title = t("career.heading");
const description = t("career.p");
---

<Layout {title} {description}>
	<div class="container py-12">
		<div class="text-center mb-12 space-y-4">
			<h1 class="font-heading font-extrabold text-4xl">{t('career.heading')}</h1>
			<p class="text-lg text-pretty">{t('career.p')}</p>
		</div>

		<div class="grid md:grid-cols-2 gap-8 max-w-screen-lg mx-auto">
			{
				careers.length > 0 ? (
					careers.map((career: CareerCardType) => <CareerCard {...career} />)
				) : (
					<p class="col-span-full text-center text-default-500">No open positions available currently.</p>
				)
			}
		</div>
	</div>
</Layout>
