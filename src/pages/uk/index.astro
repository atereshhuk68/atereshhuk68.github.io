---
import Layout from "@layouts/Layout.astro";

import SectionAbout from "@components/sections/About/SectionAbout.astro";
import SectionContact from "@components/sections/Contact/SectionContact.astro";
import SectionHero from "@components/sections/Hero/SectionHero.astro";
import SectionServices from "@components/sections/Services/SectionServices.astro";

const title = "BFancy: Професійний манікюр, макіяж та косметичні послуги";
const description =
	"Відкрийте для себе BFancy: майстерний манікюр, дизайн нігтів, макіяж, догляд за бровами та масаж. Ми гарантуємо якість та задоволення завдяки преміальним продуктам. Відчуйте себе впевнено та особливо!";
---

<Layout {title} {description}>
	<SectionHero />
	<SectionAbout />
	<SectionServices />
	<SectionContact />
</Layout>
