---
import SectionContact from "@/components/sections/SectionContact.astro";
import SectionFirstScreen from "@/components/sections/SectionFirstScreen.astro";
import SectionServices from "@/components/sections/SectionServices.astro";
import Layout from "@/layouts/Layout.astro";

const title = "BFancy: Професійний манікюр, макіяж та косметичні послуги";
const description =
  "Відкрийте для себе BFancy: майстерний манікюр, дизайн нігтів, макіяж, догляд за бровами та масаж. Ми гарантуємо якість та задоволення завдяки преміальним продуктам. Відчуйте себе впевнено та особливо!";
---

<Layout {title} {description}>
  <SectionFirstScreen />
  <SectionServices />
  <SectionContact />
</Layout>
