---
import SectionContact from "@/components/sections/SectionContact.astro";
import SectionFirstScreen from "@/components/sections/SectionFirstScreen.astro";
import SectionServices from "@/components/sections/SectionServices.astro";
import Layout from "@/layouts/Layout.astro";

const metaTitle = "BFancy Warsaw Ochota | Manicure, Pedicure & Nail Salon";
const metaDescription =
  "Discover BFancy (Be Fancy), a beauty salon in Warsaw Ochota for manicure, hybrid manicure, pedicure, nail styling and brow lamination with premium service quality.";
