---
import Layout from "@layouts/Layout.astro";

import SectionAbout from "@components/sections/About/SectionAbout.astro";
import SectionContact from "@components/sections/Contact/SectionContact.astro";
import SectionHero from "@components/sections/Hero/SectionHero.astro";
import SectionServices from "@components/sections/Services/SectionServices.astro";

const title = "BFancy: Professional Manicure, Make-up & Beauty Services";
const description =
	"Discover BFancy for expert manicure, nail styling, make-up, brow grooming & massage. We guarantee quality & satisfaction with premium products. Feel confident and special!";
---

<Layout {title} {description}>
	<SectionHero />
	<SectionAbout />
	<SectionServices />
	<SectionContact />
</Layout>
