---
import Layout from "@layouts/Layout.astro";

import SectionAbout from "@components/sections/About/SectionAbout.astro";
import SectionContact from "@components/sections/Contact/SectionContact.astro";
import SectionHero from "@components/sections/Hero/SectionHero.astro";
import SectionServices from "@components/sections/Services/SectionServices.astro";

const title = "BFancy: Profesjonalny Manicure, Makijaż i Usługi Kosmetyczne";
const description =
	"Odkryj BFancy - ekspert w dziedzinie manicure, stylizacji paznokci, makijażu, pielęgnacji brwi i masażu. Gwarantujemy jakość i satysfakcję dzięki produktom premium. Poczuj się pewnie i wyjątkowo!";
---

<Layout {title} {description}>
	<SectionHero />
	<SectionAbout />
	<SectionServices />
	<SectionContact />
</Layout>
