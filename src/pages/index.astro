---
import SectionContact from "@/components/sections/SectionContact.astro";
import SectionFirstScreen from "@/components/sections/SectionFirstScreen.astro";
import SectionServices from "@/components/sections/SectionServices.astro";
import Layout from "@/layouts/Layout.astro";

const metaTitle =
  "BFancy: Profesjonalny Manicure, Makijaż i Usługi Kosmetyczne";
const metaDescription =
  "Odkryj BFancy - ekspert w dziedzinie manicure, stylizacji paznokci, makijażu, pielęgnacji brwi i masażu. Gwarantujemy jakość i satysfakcję dzięki produktom premium. Poczuj się pewnie i wyjątkowo!";
---

<Layout metaTitle={metaTitle} metaDescription={metaDescription}>
  <SectionFirstScreen />
  <SectionServices />
  <SectionContact />
</Layout>
