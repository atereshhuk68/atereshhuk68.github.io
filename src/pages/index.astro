---
import SectionContact from "@/components/sections/SectionContact.astro";
import SectionFirstScreen from "@/components/sections/SectionFirstScreen.astro";
import SectionServices from "@/components/sections/SectionServices.astro";
import Layout from "@/layouts/Layout.astro";

const metaTitle = "BFancy | Manicure i Paznokcie Warszawa Ochota";
const metaDescription =
  "BFancy to salon kosmetyczny Warszawa Ochota: manicure, manicure hybrydowy, pedicure, stylizacja paznokci i laminowanie brwi. Umów wizytę i poznaj nasze usługi premium.";
---

<Layout metaTitle={metaTitle} metaDescription={metaDescription}>
  <SectionFirstScreen />
  <SectionServices />
  <SectionContact />
</Layout>
