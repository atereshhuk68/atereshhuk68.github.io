---
import SectionContact from "@/components/sections/SectionContact.astro";
import SectionFirstScreen from "@/components/sections/SectionFirstScreen.astro";
import SectionServices from "@/components/sections/SectionServices.astro";
import Layout from "@/layouts/Layout.astro";

const title = "BFancy: Профессиональный маникюр, макияж и косметические услуги";
const description =
  "Откройте для себя BFancy: экспертный маникюр, дизайн ногтей, макияж, уход за бровями и массаж. Мы гарантируем качество и удовлетворение с использованием премиальных продуктов. Почувствуйте себя уверенно и особенно!";
---

<Layout {title} {description}>
  <SectionFirstScreen />
  <SectionServices />
  <SectionContact />
</Layout>
