---
import Layout from '@layouts/Layout.astro';

import SectionHero from '@components/sections/Hero/SectionHero.astro';
import SectionAbout from '@components/sections/About/SectionAbout.astro';
import SectionServices from '@components/sections/Services/SectionServices.astro';
import SectionContact from '@components/sections/Contact/SectionContact.astro';

const title = 'BFancy: Профессиональный маникюр, макияж и косметические услуги';
const description =
	'Откройте для себя BFancy: экспертный маникюр, дизайн ногтей, макияж, уход за бровями и массаж. Мы гарантируем качество и удовлетворение с использованием премиальных продуктов. Почувствуйте себя уверенно и особенно!';
---

<Layout {title} {description}>
	<SectionHero />
	<SectionAbout />
	<SectionServices />
	<SectionContact />
</Layout>
