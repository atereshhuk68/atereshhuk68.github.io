---
import SectionContact from "@/components/sections/SectionContact.astro";
import SectionFirstScreen from "@/components/sections/SectionFirstScreen.astro";
import SectionOurWorks from "@/components/sections/SectionOurWorks.astro";
import SectionServices from "@/components/sections/SectionServices.astro";
import Layout from "@/layouts/Layout.astro";

const metaTitle = "BFancy | Маникюр, педикюр и ногтевой сервис в Варшаве";
const metaDescription =
  "BFancy (Be Fancy) — салон красоты в Варшаве: маникюр, гибридный маникюр, педикюр, дизайн ногтей и ламинирование бровей с премиальным сервисом.";
---

<Layout metaTitle={metaTitle} metaDescription={metaDescription}>
  <SectionFirstScreen />
  <SectionOurWorks />
  <SectionServices />
  <SectionContact />
</Layout>
