---
import { Button } from '@/components/starwind/button';
import { useTranslations } from '@/lib/handle-ui-translations';
import type { Locales } from '@/types';
import { Check, X } from '@lucide/astro';

const { currentLocale = 'pl' } = Astro;

const t = useTranslations(currentLocale as Locales);
---

<dialog
	id="successModal"
	class="m-auto w-[90%] max-w-[544px] space-y-8 rounded-lg bg-white px-8 pb-10 pt-8 text-center text-black-800 shadow-card outline-none backdrop:bg-black-900/60"
	style="transform: scale(0.4); opacity: 0;">
	<div class="mx-auto grid gap-4">
		<div class="flex justify-center text-green-600">
			<Check size={24} stroke-width={3} />
		</div>

		<div class="text-xl font-medium">We've received your message successfully.</div>
	</div>

	<Button variant="primary" size="sm" data-close-dialog>Ok</Button>
</dialog>

<dialog
	id="errorModal"
	class="m-auto w-[90%] max-w-[544px] space-y-8 rounded-lg bg-white px-8 pb-10 pt-8 text-center text-black-800 shadow-card outline-none backdrop:bg-black-900/60"
	style="transform: scale(0.4); opacity: 0;">
	<div class="mx-auto grid gap-4">
		<div class="flex justify-center text-red-500">
			<X size={24} stroke-width={3} />
		</div>

		<div class="text-xl font-medium">Your message wasn't sent, please try again.</div>
	</div>

	<Button variant="primary" size="sm" data-close-dialog>Ok</Button>
</dialog>
