---
import { Check } from "@lucide/astro";
import Button from "@/components/starwind/button";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types";

const { currentLocale = "pl" } = Astro;

const t = useTranslations(currentLocale as Locales);
---

<dialog
  id="successModal"
  class="text-black-800 shadow-card backdrop:bg-black-900/60 m-auto w-[90%] max-w-[544px] space-y-8 rounded-lg bg-white px-8 pt-8 pb-10 text-center outline-none"
  style="transform: scale(0.4); opacity: 0;"
>
  <div class="mx-auto grid gap-4">
    <div class="flex justify-center text-green-600">
      <Check size={32} stroke-width={3} />
    </div>

    <div class="text-xl font-medium">
      {t("dialog.message.success")}
    </div>
  </div>

  <Button variant="primary" size="sm" data-close-dialog>Ok</Button>
</dialog>
