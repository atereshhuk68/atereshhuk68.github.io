---
import { Check } from "@lucide/astro";
import Button from "@/components/starwind/button";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types";
import {
  Dialog,
  DialogContent,
  DialogClose,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "@/components/starwind/dialog";

const { currentLocale = "pl" } = Astro;

const t = useTranslations(currentLocale as Locales);
---

<Dialog id="successModal">
  <DialogContent>
    <DialogHeader>
      <DialogTitle class="text-center">😉</DialogTitle>
    </DialogHeader>

    <div class="py-4 text-center">{t("dialog.message.success")}</div>

    <DialogFooter class="sm:justify-center">
      <DialogClose asChild>
        <Button variant="default">{t("dialog.button.success")}</Button>
      </DialogClose>
    </DialogFooter>
  </DialogContent>
</Dialog>
