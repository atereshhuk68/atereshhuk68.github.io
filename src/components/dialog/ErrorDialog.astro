---
import { Button } from "@/components/starwind/button";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types";
import {
  Dialog,
  DialogContent,
  DialogClose,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  DialogDescription,
} from "@/components/starwind/dialog";

const { currentLocale = "pl" } = Astro;

const t = useTranslations(currentLocale as Locales);
---

<Dialog id="errorModal">
  <DialogContent>
    <DialogHeader>
      <DialogTitle class="text-center">
        <span class="sr-only">{t("dialog.error")}</span>
        <span>😲</span>
      </DialogTitle>
    </DialogHeader>

    <div class="py-4 text-center">{t("dialog.message.error")}</div>

    <DialogFooter class="sm:justify-center">
      <DialogClose asChild>
        <Button variant="default">{t("dialog.button.error")}</Button>
      </DialogClose>
    </DialogFooter>
  </DialogContent>
</Dialog>
