---
import { Image } from 'astro:assets';
import { useTranslations } from '@/lib/handle-ui-translations';
import type { Locales } from '@/types';
import type { ImageMetadata } from 'astro';
import { shuffle } from 'es-toolkit';

const examplesImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/pixel/persons/*.webp', { eager: true });

const images = Object.values(examplesImages).map((mod) => mod.default);

const { currentLocale = 'pl' } = Astro;
const t = useTranslations(currentLocale as Locales);
---

<div class="embla" data-slider="about-us-slider">
	<div class="embla__viewport">
		<div class="embla__container">
			{
				shuffle(images).map((image, i) => (
					<div class="embla__slide">
						<a class="flex aspect-[3/2] w-full h-full" href={image.src} data-pswp-width={image.width / 2} data-pswp-height={image.height / 2} target="_blank">
							<Image
								class="w-full h-full object-cover object-top rounded-4xl"
								src={image}
								alt={`${t('imageAlt')} ${++i}`}
								height={image.height / 3}
								width={image.width / 3}
								format="avif"
								quality={'high'}
							/>
						</a>
					</div>
				))
			}
		</div>
	</div>
</div>

<script>
	import EmblaCarousel, { type EmblaOptionsType } from 'embla-carousel';

	const SLIDER_SELECTOR = '.embla[data-slider="about-us-slider"]';
	const VIEWPORT_SELECTOR = '.embla[data-slider="about-us-slider"] .embla__viewport';

	const OPTIONS: EmblaOptionsType = { axis: 'y' };

	const emblaNode = document.querySelector<HTMLElement>(VIEWPORT_SELECTOR);

	if (emblaNode) {
		const emblaApi = EmblaCarousel(emblaNode, OPTIONS);
	}
</script>
