---
import { useTranslations } from '@i18n/utils';
import type { Locales } from 'src/types';

const { currentLocale = 'pl' } = Astro;

const t = useTranslations(currentLocale as Locales);
---

<label class="relative w-full">
	<span class="sr-only">
		{t('contact.useremail')}
	</span>
	<input
		placeholder={t('contact.useremail')}
		required
		type="email"
		name="userEmail"
		class="border border-black-500 bg-white placeholder:text-black-300 py-3 px-6 w-full rounded-md"
	/>
	<span class="text-red-500 text-xs absolute bottom-0 left-0 h-[2lh] -mb-[2lh]" data-error="userEmail"></span>
</label>
