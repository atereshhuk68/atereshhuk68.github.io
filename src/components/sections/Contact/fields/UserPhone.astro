---
import { useTranslations } from '@i18n/utils';
import type { Locales } from 'src/types/types';

const { currentLocale = 'pl' } = Astro;

const t = useTranslations(currentLocale as Locales);
---

<div class="relative w-full">
	<label for="userName" class="sr-only">
		{t('contact.userphone')}
	</label>
	<input
		id="userPhone"
		placeholder={t('contact.userphone')}
		required
		type="text"
		inputmode="numeric"
		name="userPhone"
		class="border border-black-500 bg-white placeholder:text-black-300 py-3 px-6 w-full rounded-md"
	/>
	<span class="text-red-500 text-xs absolute bottom-0 left-0 h-[2lh] -mb-[2lh]" data-error="userPhone"></span>
</div>

<script>
	import { MaskInput } from 'maska';

	const phoneField = document.querySelector<HTMLInputElement>('#userPhone');

	if (phoneField) {
		new MaskInput(phoneField, {
			mask: '+#################',
		});
	}
</script>
