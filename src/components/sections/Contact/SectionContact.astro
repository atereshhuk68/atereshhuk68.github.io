---
import { useTranslations } from '@i18n/utils';
import type { Locales } from 'src/types';
import ContactForm from './ContactForm.astro';

const { currentLocale = 'pl' } = Astro;

const t = useTranslations(currentLocale as Locales);
---

<section class="relative isolate overflow-x-clip py-12">
	<div class="container">
		<div class="space-y-4 text-center text-base sm:text-lg lg:text-xl mb-12">
			<h2 class="text-3xl sm:text-4xl text-balance font-heading">
				{t('contact.heading')}
			</h2>

			<p class="text-black-600 max-w-3xl mx-auto">
				{t('contact.p1')}
			</p>

			<p class="text-black-600 max-w-3xl mx-auto">
				{t('contact.p2_start')}
				<a href="https://ig.me/m/bfancy.warsaw" target="_blank" rel="noopener" class="underline font-medium hover:text-cove-600 transition-[color] duration-200">Instagram Direct</a
				>
				{t('contact.p2_end')}
			</p>
		</div>

		<div class="max-w-5xl mx-auto relative isolate">
			<ContactForm />

			<div id="rotatedText" class="lazy-bg absolute top-1/2 left-0 -translate-y-1/2 -translate-x-1/2 aspect-square w-[400px] h-auto z-[-1]" data-bg-name="rotated-sentence-w550">
			</div>
		</div>
	</div>

	<span class="lazy-bg absolute top-1/2 right-0 -translate-y-1/2 translate-x-1/2 aspect-square w-[770px] h-auto z-[-1]" data-bg-name="decor-blur-yellow-star-w770"></span>
</section>

<script>
	const rotatedText = document.getElementById('rotatedText');

	const keyframes: Keyframe[] = [{ transform: 'rotate(0deg)' }, { transform: 'rotate(-360deg)' }];

	const options: KeyframeAnimationOptions = {
		duration: 20000,
		iterations: Infinity,
		easing: 'linear',
	};

	rotatedText?.animate(keyframes, options);
</script>
