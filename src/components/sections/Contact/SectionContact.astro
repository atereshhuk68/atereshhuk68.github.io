---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import ContactForm from './ContactForm.astro';
import { motion } from 'framer-motion';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="relative isolate overflow-x-clip py-12">
	<div class="container">
		<div class="space-y-4 text-center text-base sm:text-lg lg:text-xl mb-12">
			<h2 class="text-3xl sm:text-4xl lg:text-5xl text-balance font-heading font-extrabold">
				{t('contact.heading')}
			</h2>

			<p class="text-black-600 max-w-3xl mx-auto">
				{t('contact.p1')}
			</p>

			<p class="text-black-600 max-w-3xl mx-auto">
				{t('contact.p2_start')}
				<a href="https://ig.me/m/bfancy.warsaw" target="_blank" rel="noopener" class="underline font-medium hover:text-cove-600 transition-[color] duration-200">Instagram Direct</a
				>
				{t('contact.p2_end')}
			</p>
		</div>

		<div class="max-w-5xl mx-auto relative isolate">
			<ContactForm />

			<motion.div
				id="rotatedText"
				animate={{ rotate: 360 }}
				transition={{ repeat: Infinity, ease: 'linear', duration: 30 }}
				className="lazy-bg absolute top-1/2 left-0 -translate-y-1/2 -translate-x-1/2 aspect-square w-[400px] h-auto z-[-1]"
				data-bg-name="rotated-sentence-w550"
				client:visible
			/>
		</div>
	</div>

	<span class="lazy-bg absolute top-1/2 right-0 -translate-y-1/2 translate-x-1/2 aspect-square w-[770px] h-auto z-[-1]" data-bg-name="decor-blur-yellow-star-w770"></span>
</section>
