---
import { Link } from '@heroui/react';
import { Image } from 'astro:assets';

import AboutUsImage from '@assets/images/about-us-image-w782.png';

import { getLangFromUrl, useTranslations } from '@i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section id="aboutUs" class="py-12 sm:py-20 lg:py-32 relative isolate overflow-hidden">
	<div class="container">
		<div class="grid lg:grid-cols-2 gap-8 content-start">
			<div class="space-y-4">
				<h2 class="font-heading text-2xl sm:text-3xl md:text-4xl lg:text-[44px] lg:leading-tight text-balance">
					{t('about.h2')}
				</h2>

				<p class="text-base md:text-lg">
					{t('about.p1')}
				</p>

				<p class="text-base md:text-lg">
					{t('about.p2')}
				</p>

				<p class="text-base md:text-lg">
					<Link
						client:visible
						className="text-black-900 underline hover:no-underline font-semibold cursor-pointer"
						href="https://www.instagram.com/bfancy.warsaw"
						rel="noopener noreferrer"
						isExternal
						showAnchorIcon>
						{t('about.instagram')}
					</Link>
				</p>

				<hr />

				<p class="text-base md:text-lg">{t('about.other')}</p>

				<ul class="space-y-4">
					<li>
						<Link client:visible className="text-black-900 underline hover:no-underline font-bold cursor-pointer" isExternal>Facebook</Link>
					</li>
					<li>
						<Link client:visible className="text-black-900 underline hover:no-underline font-bold cursor-pointer" isExternal>Telegram</Link>
					</li>
				</ul>
			</div>

			<Image
				src={AboutUsImage}
				alt="About Us"
				width={782}
				height={782}
				class="rounded-xl object-cover object-center sm:object-[0_-200px] lg:object-center max-h-[300px] lg:max-h-[763px]"
				loading="lazy"
				format="webp"
			/>
		</div>
	</div>

	<div class="lazy-bg inline-flex size-[770px] absolute top-1/2 -translate-y-1/2 -translate-x-1/2 left-0 z-[-1] decor-blur-blue-star-w770"></div>
</section>
