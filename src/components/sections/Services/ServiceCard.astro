---
import type { Service } from "@/types";

type Props = Service;

const { name, list } = Astro.props;
---

<div class="bg-black-100 h-full min-h-[280px] space-y-4 rounded-lg p-6">
  <strong class="font-heading flex text-2xl">{name}</strong>

  <ul class="divide-black-200 space-y-2 divide-y-1">
    {
      list.map(({ title, price, description, currency }) => (
        <li class="flex justify-between gap-2 pb-2">
          <div class="flex flex-col">
            <span>{title}</span>
            {description && (
              <span class="text-black-600 text-sm">{description}</span>
            )}
          </div>
          <span class="flex flex-shrink-0 items-baseline gap-1 font-medium">
            {price}
            <span>{currency ?? " zł"}</span>
          </span>
        </li>
      ))
    }
  </ul>
</div>
