---
import { getCollection } from 'astro:content';
import { Services } from './Services.tsx';

const services = await getCollection('services');
const servicesData = services.map((service) => service.data);
---

<section id="services" class="py-12 sm:py-16 lg:py-20 min-h-[1000px]">
	<div class="container">
		<div class="mb-6 sm:mb-8 lg:mb-12">
			<h2 class="text-4xl lg:text-5xl font-heading text-balance">BFancy Salon Services and Prices</h2>
			<p class="text-lg">See our salon services grouped by categories. If you need all list of services, click on the card</p>
		</div>

		<Services services={servicesData} client:visible />
	</div>
</section>
