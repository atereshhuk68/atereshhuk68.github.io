---
import { shuffle } from 'es-toolkit';
import { Catalog } from './Catalog.tsx';
import { TabControl } from './TabControl.tsx';
import { useTranslations } from '@i18n/utils';
import { getCollection } from 'astro:content';

const { currentLocale = 'pl' } = Astro;

const t = useTranslations(currentLocale);

const Services = await getCollection('services');
const ServicesFiltered = Services.find((entry) => entry.id.startsWith(currentLocale));
const ServicesData = ServicesFiltered?.data ?? [];

const ctaText = t('services.cta');
---

<section id="services" class="py-12 sm:py-16 lg:py-20 min-h-[1100px]">
	<div class="container">
		<div class="mb-6 sm:mb-8 lg:mb-12 grid gap-3">
			<h2 class="text-4xl lg:text-5xl font-heading text-balance font-extrabold">
				{t('services.h2')}
			</h2>

			<p class="text-lg max-w-3xl">
				{t('services.p')}
			</p>
		</div>

		<TabControl client:load />

		<Catalog services={shuffle(ServicesData)} {ctaText} client:load />
	</div>
</section>
