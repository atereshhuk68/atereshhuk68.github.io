---
import { shuffle } from 'es-toolkit';
import { ServicesSection } from './Services.tsx';

import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { getCollection } from 'astro:content';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const Services = await getCollection('services');
const ServicesFiltered = Services.find((entry) => entry.id.startsWith(currentLang));
const ServicesData = ServicesFiltered?.data ?? [];

const ctaText = t('services.cta');
---

<section id="services" class="py-12 sm:py-16 lg:py-20 min-h-[1100px]">
	<div class="container">
		<div class="mb-6 sm:mb-8 lg:mb-12 grid gap-3">
			<h2 class="text-4xl lg:text-5xl font-heading text-balance font-extrabold">
				{t('services.h2')}
			</h2>

			<p class="text-lg max-w-3xl">
				{t('services.p')}
			</p>
		</div>

		<ServicesSection services={shuffle(ServicesData)} {ctaText} client:load />
	</div>
</section>
