---
import { ServicesSection } from './Services.tsx';
import Services from '../../../data/services.json';

import { getLangFromUrl, useTranslations } from '@i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const ctaText = t('services.cta');
---

<section id="services" class="py-12 sm:py-16 lg:py-20 min-h-[1100px]">
	<div class="container">
		<div class="mb-6 sm:mb-8 lg:mb-12">
			<h2 class="text-4xl lg:text-5xl font-heading text-balance">
				{t('services.h2')}
			</h2>

			<p class="text-lg max-w-3xl">
				{t('services.p')}
			</p>
		</div>

		<ServicesSection services={Services} {ctaText} client:load />
	</div>
</section>
