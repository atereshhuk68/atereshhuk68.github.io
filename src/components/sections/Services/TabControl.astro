---
import Button from "@/components/starwind/button";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types";
import type { ServiceType } from "@/types/services";

const ICON_MAP: Record<string, string> = {
  nails: "service-nails-w64",
  visage: "service-visage-w64",
  massage: "service-massage-w64",
  eyelashes: "service-eyelashes-w64",
  hair: "service-hair-w64",
};

const { currentLocale = "pl" } = Astro;
const t = useTranslations(currentLocale as Locales);

interface Props {
  serviceTypes: ServiceType[];
  activeType: ServiceType;
}

const { serviceTypes, activeType } = Astro.props;
---

<div
  class="grid w-full grid-cols-2 flex-nowrap items-center gap-1 overflow-x-auto sm:flex xl:w-auto"
>
  {
    serviceTypes.map((type: string) => {
      const filterTitle = t(`services.type.${type}` as any);

      return (
        <Button
          variant="ghost"
          size="md"
          data-filter={type}
          class="flex-grow px-6 text-base md:flex-shrink-0 xl:px-5"
          aria-pressed={type === activeType}
        >
          <span class={`lazy-bg size-5 flex-shrink-0 ${ICON_MAP[type]}`} />
          {filterTitle}
        </Button>
      );
    })
  }
</div>

<script>
  const EXIT_DURATION = 200; // синхронно з service-card-out у global.css

  const tabButtons =
    document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>(
    "[data-service-cards] > [data-type]",
  );

  let activeType = document.querySelector<HTMLElement>(
    "[data-filter][aria-pressed='true']",
  )?.dataset.filter;
  let swapTimer: ReturnType<typeof setTimeout> | undefined;

  const revealCards = (type: string) => {
    let index = 0;

    for (const card of cards) {
      card.classList.remove("is-leaving", "is-entering");

      const isVisible = card.dataset.type === type;
      card.hidden = !isVisible;

      if (isVisible) {
        card.style.setProperty("--reveal-i", String(index++));
        card.classList.add("is-entering");
      }
    }
  };

  const handleClickServiceFilter = (event: Event) => {
    const { filter } = (event.currentTarget as HTMLButtonElement).dataset;
    if (!filter || filter === activeType) return;

    activeType = filter;

    for (const button of tabButtons) {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.filter === filter),
      );
    }

    for (const card of cards) {
      if (!card.hidden) card.classList.add("is-leaving");
    }

    clearTimeout(swapTimer);
    swapTimer = setTimeout(() => revealCards(filter), EXIT_DURATION);
  };

  for (const tabButton of tabButtons) {
    tabButton.addEventListener("click", handleClickServiceFilter);
  }
</script>
