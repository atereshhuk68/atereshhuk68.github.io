---
import Button from "@/components/starwind/button";
import { useTranslations } from "@/lib/handle-ui-translations";
import { $activeServiceType } from "@/stores/catalog-store/services-store";
import type { Locales } from "@/types";
import type { ServiceType } from "@/types/services";

const ICON_MAP: Record<string, string> = {
  nails: "service-nails-w64",
  visage: "service-visage-w64",
  massage: "service-massage-w64",
  eyelashes: "service-eyelashes-w64",
  hair: "service-hair-w64",
};

const { currentLocale = "pl" } = Astro;
const t = useTranslations(currentLocale as Locales);

interface Props {
  serviceTypes: ServiceType[];
}

const { serviceTypes } = Astro.props;
---

<div
  class="grid w-full grid-cols-2 flex-nowrap items-center gap-1 overflow-x-auto sm:flex xl:w-auto"
>
  {
    serviceTypes.map((type: string) => {
      const isActive = type === $activeServiceType.get();
      const filterTitle = t(`services.type.${type}` as any);

      return (
        <Button
          variant="ghost"
          size="md"
          data-filter={type}
          class="flex-grow px-6 text-base md:flex-shrink-0 xl:px-5"
          aria-pressed={isActive}
        >
          <span class={`lazy-bg size-5 flex-shrink-0 ${ICON_MAP[type]}`} />
          {filterTitle}
        </Button>
      );
    })
  }
</div>

<script>
  import {
    setActiveServiceType,
    $activeServiceType,
  } from "@/stores/catalog-store/services-store";

  const tabButtons = document.querySelectorAll("[data-filter]");

  const setActiveButton = (button: HTMLButtonElement) => {
    for (const tabButton of tabButtons) {
      tabButton.setAttribute("aria-pressed", "false");
      tabButton.classList.remove("active");
    }

    button.setAttribute("aria-pressed", "true");
    button.classList.add("active");
  };

  const handleClickServiceFilter = (event: Event) => {
    const clickedButton = event.currentTarget as HTMLButtonElement;
    const { filter } = clickedButton.dataset;

    if (filter) {
      setActiveServiceType(filter);
    }
  };

  for (const tabButton of tabButtons) {
    tabButton.addEventListener("click", handleClickServiceFilter);

    $activeServiceType.subscribe((activeServiceType) => {
      const activeButton = document.querySelector(
        `[data-filter="${activeServiceType}"]`,
      ) as HTMLButtonElement;

      if (activeButton) {
        setActiveButton(activeButton);
      }
    });
  }
</script>
