---
import { Image } from 'astro:assets';

import { Button } from '@heroui/react';
import { motion } from 'framer-motion';
import { ExternalLink } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

import GridImage from '@assets/images/hero-demo-photo-w736.webp';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<div class="container">
	<div class="grid sm:grid-cols-[225px_1fr] lg:grid-cols-2 gap-5 xl:gap-8 sm:pt-8">
		<div
			class="bg-golden-200 text-black-900 py-11 lg:py-[120px] px-5 sm:px-6 xl:px-8 rounded-2xl grid content-start justify-items-start gap-6 sm:col-span-2 lg:col-span-1 lg:row-span-2 relative isolate overflow-hidden">
			<div class="grid gap-3">
				<h1 class="text-3xl lg:text-4xl xl:text-5xl font-heading text-balance font-extrabold">
					{t('hero.h1')}
				</h1>

				<p class="text-lg">
					{t('hero.p')}
				</p>
			</div>

			<Button variant="solid" size="lg" color="primary" radius="sm" className="bg-black-900" client:load>
				{t('hero.cta')}
			</Button>

			<small class="text-xs font-medium text-black-500">{t('hero.note')}</small>

			<motion.div
				animate={{ rotate: 360 }}
				transition={{ repeat: Infinity, ease: 'linear', duration: 20 }}
				className="lazy-mask inline-flex size-[200px] lg:size-[300px] decor-star-w300 absolute bottom-[-70px] right-[-70px] lg:bottom-[-120px] lg:right-[-120px] z-[-1] pointer-events-none"
				client:visible
			/>
		</div>

		<div class="bg-black-600 rounded-2xl overflow-hidden hidden sm:block">
			<Image
				src={GridImage}
				alt="Nail and Makeup Services"
				class={`aspect-${GridImage.width / GridImage.height} object-cover lg:object-[0_-125px] xl:object-[0_-220px] 2xl:object-[0_-280px] h-full lg:h-[300px]`}
				format="webp"
				width={736}
				height={736}
			/>
		</div>

		<div class="bg-shell-300 text-black-900 rounded-2xl py-6 px-5 sm:p-6 lg:p-8 space-y-4">
			<strong class="text-2xl lg:text-3xl font-heading flex mb-3">
				{t('hero.strong')}
			</strong>

			<p class="text-base lg:text-lg">
				{t('hero.second.p')}
			</p>

			<hr />

			<a
				target="_blank"
				class="text-black-900 underline hover:no-underline font-semibold cursor-pointer inline-flex gap-1 items-center"
				href="https://maps.app.goo.gl/MNJ9LVHxZKGLBDd86?g_st=com.google.maps.preview.copy"
				rel="noopener noreferrer">
				<span>
					{t('hero.reviews')}
				</span>

				<ExternalLink size={20} strokeWidth={2} />
			</a>
		</div>
	</div>
</div>
