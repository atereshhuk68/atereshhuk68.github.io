---
import { Button, Link } from '@heroui/react';

import GridImage from '@assets/images/hero-demo-photo-w736.webp';
import { Image } from 'astro:assets';
import { motion } from 'framer-motion';
---

<div class="container">
	<div class="grid sm:grid-cols-[225px_1fr] lg:grid-cols-2 gap-5 xl:gap-8 sm:pt-8">
		<div
			class="bg-golden-200 text-black-900 py-11 lg:py-[120px] px-6 xl:px-8 rounded-2xl grid content-start justify-items-start gap-6 sm:col-span-2 lg:col-span-1 lg:row-span-2 relative isolate overflow-hidden">
			<div class="grid gap-4">
				<h1 class="text-3xl lg:text-4xl xl:text-5xl font-heading text-balance">At BFancy, we fulfill not only dreams, but also stylish fantasies!</h1>

				<p class="text-lg">
					Professional manicure, nail styling, make-up, eyebrows grooming and relaxing massages - everything to make you feel confident and special. Our specialists will take care
					of every detail, and you can just... be yourself.
				</p>
			</div>

			<Button variant="solid" size="lg" color="primary" radius="sm" className="bg-black-900" client:load>Schedule Your Appointment</Button>

			<small class="text-xs font-medium text-black-500">BFancy - beauty starts right here. Make an appointment today!</small>

			<motion.div
				animate={{ rotate: 360 }}
				transition={{ repeat: Infinity, ease: 'linear', duration: 20 }}
				className="lazy-mask inline-flex size-[200px] lg:size-[300px] decor-star-w300 absolute bottom-[-70px] right-[-70px] lg:bottom-[-120px] lg:right-[-120px] z-[-1] pointer-events-none"
				client:visible
			/>
		</div>

		<div class="bg-black-600 rounded-2xl overflow-hidden hidden sm:block">
			<Image
				src={GridImage}
				alt="Nail and Makeup Services"
				class={`aspect-${GridImage.width / GridImage.height} object-cover lg:object-[position:0_-125px] xl:object-[position:0_-220px] 2xl:object-[position:0_-280px] h-full lg:h-[281px]`}
				format="webp"
				width={736}
				height={736}
			/>
		</div>

		<div class="bg-shell-300 rounded-2xl p-6 lg:p-8 space-y-4">
			<strong class="text-2xl lg:text-3xl font-heading">We stand by our quality. Not satisfied? We'll make it right!</strong>

			<p class="text-base lg:text-lg">
				At our salon, your satisfaction is our top priority. Our skilled professionals use only premium products and follow the highest standards to ensure exceptional results
				every time.
			</p>

			<hr />

			<p>
				<Link
					isExternal
					showAnchorIcon
					className="text-black-900 underline hover:no-underline font-semibold cursor-pointer"
					href="https://maps.app.goo.gl/MNJ9LVHxZKGLBDd86?g_st=com.google.maps.preview.copy"
					rel="noopener noreferrer"
					client:load>Check our latest reviews</Link
				>
			</p>
		</div>
	</div>
</div>
