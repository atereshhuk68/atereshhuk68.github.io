---
import { getCollection } from "astro:content";
import ServiceCard from "@/components/sections/Services/ServiceCard.astro";
import TabControl from "@/components/sections/Services/TabControl.astro";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales, Service } from "@/types";

const { currentLocale = "pl" } = Astro;
const t = useTranslations(currentLocale as Locales);

const services = await getCollection("services");
const servicesByLocale = services.find((entry) =>
  entry.id.startsWith(currentLocale),
);

const servicesData: Service[] = servicesByLocale?.data ?? [];
const serviceTypes = [...new Set(servicesData.map((s) => s.type))];

const DEFAULT_SERVICE_TYPE = "nails";
---

<section id="services" class="min-h-200 py-12">
  <div class="container">
    <div class="flex flex-wrap gap-6 xl:justify-between xl:gap-8">
      <div class="space-y-3 text-lg xl:max-w-140 2xl:max-w-3xl">
        <h2 class="font-heading text-4xl text-balance lg:text-5xl">
          {t("services.h2")}
        </h2>

        <p class="min-w-0">{t("services.p")}</p>
      </div>

      <TabControl serviceTypes={serviceTypes} activeType={DEFAULT_SERVICE_TYPE} />
    </div>

    <div
      class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:col-span-2 2xl:grid-cols-4"
      data-service-cards
    >
      {
        servicesData.map((service) => (
          <div
            data-type={service.type}
            hidden={service.type !== DEFAULT_SERVICE_TYPE}
          >
            <ServiceCard {...service} />
          </div>
        ))
      }
    </div>
  </div>
</section>
