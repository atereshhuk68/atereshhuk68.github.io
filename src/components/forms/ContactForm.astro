---
import Button from "@/components/starwind/button";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types";
import UserEmail from "./fields/UserEmail.astro";
import UserMessage from "./fields/UserMessage.astro";
import UserName from "./fields/UserName.astro";
import UserPhone from "./fields/UserPhone.astro";

const { currentLocale = "pl" } = Astro;

const t = useTranslations(currentLocale as Locales);
---

<div class="border-black-300 bg-black-100 rounded-xl border px-4 py-12 md:px-8">
  <form
    class="mx-auto grid max-w-lg place-items-center space-y-8"
    method="post"
    data-contact-form
  >
    <UserName />

    <UserPhone />

    <UserEmail />

    <UserMessage />

    <Button
      variant="secondary"
      size="lg"
      class="bg-golden-200 text-black-900 peer inline-flex min-w-50 items-center gap-2 font-medium disabled:opacity-50"
      type="submit"
    >
      {t("contact.submittext")}
    </Button>
  </form>
</div>

<script>
  import {
    resetFormErrors,
    clearInputError,
    renderFieldErrors,
  } from "@/lib/handle-errors";
  import {
    setSubmitButtonEnabled,
    setSubmitButtonDisabled,
  } from "@/lib/handle-submit-button";
  import { validateFormBySchema } from "@/lib/handle-form-validation";
  import { postFormPayload } from "@/lib/handle-form-submit";
  import {
    closeStarwindUiDialog,
    openStarwindUiDialog,
  } from "@/lib/handle-dialogs";
  import { getContactFormSchema } from "@/schemas/forms";
  import type { Locales } from "@/types";

  const currentLocale = (document.body.dataset.currentLocale ||
    "pl") as Locales;

  const contactFormSchema = getContactFormSchema(currentLocale);

  const SELECTORS = {
    contactForm: "form[data-contact-form]",
    contactFormFields:
      "form[data-contact-form] input, form[data-contact-form] textarea",
    errorDialogWrapper: "#errorModal",
    successDialogWrapper: "#successModal",
  };

  const ELEMENTS = {
    contactForm: document.querySelector<HTMLFormElement>(SELECTORS.contactForm),
    contactFormFields: document.querySelectorAll<HTMLInputElement>(
      SELECTORS.contactFormFields,
    ),
    errorDialogWrapper: document.querySelector<HTMLDivElement>(
      SELECTORS.errorDialogWrapper,
    ),
    successDialogWrapper: document.querySelector<HTMLDivElement>(
      SELECTORS.successDialogWrapper,
    ),
  };

  const handleSubmit = async (event: SubmitEvent) => {
    event.preventDefault();

    const submittedForm = event.currentTarget as HTMLFormElement;
    const submitButton = event.submitter as HTMLButtonElement;

    resetFormErrors(submittedForm);

    const {
      success: validationSuccess,
      data,
      error: validationErrors,
    } = validateFormBySchema(submittedForm, contactFormSchema);

    if (!validationSuccess) {
      const errors = validationErrors.flatten().fieldErrors;

      renderFieldErrors(submittedForm, errors);

      return;
    }

    setSubmitButtonDisabled(submitButton);

    const { success } = await postFormPayload(data);

    if (success) {
      if (ELEMENTS.successDialogWrapper) {
        openStarwindUiDialog(ELEMENTS.successDialogWrapper);

        submittedForm.reset();
      }
    } else {
      if (ELEMENTS.errorDialogWrapper) {
        openStarwindUiDialog(ELEMENTS.errorDialogWrapper);
      }
    }

    setSubmitButtonEnabled(submitButton);
  };

  const setEventListeners = () => {
    ELEMENTS.contactForm?.addEventListener("submit", handleSubmit);

    if (ELEMENTS.contactFormFields) {
      for (const formField of ELEMENTS.contactFormFields) {
        formField.addEventListener("input", (event) => {
          const field = event.currentTarget as HTMLInputElement;

          clearInputError(field);
        });
      }
    }
  };

  const init = () => {
    setEventListeners();
  };

  init();
</script>
