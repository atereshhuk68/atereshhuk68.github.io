---
import { getCollection } from "astro:content";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/starwind/select";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales, Service } from "@/types";

const { currentLocale = "pl" } = Astro;
const t = useTranslations(currentLocale as Locales);

const Services = await getCollection("services");
const ServicesFiltered = Services.find((entry) =>
  entry.id.startsWith(currentLocale),
);

const services: Service[] = ServicesFiltered?.data ?? [];
const serviceTypes = [...new Set(services.map((s) => s.type))];
---

<div class="relative flex w-full">
  <label class="sr-only">Field Name Add Later</label>

  <Select
    id="userServiceCategory"
    name="userServiceCategory"
    class="w-full text-base"
  >
    <SelectTrigger class="w-full">
      <SelectValue placeholder={t("specialOffer.serviceSelect")} />
    </SelectTrigger>
    <SelectContent>
      {
        serviceTypes.map((item) => (
          <SelectItem value={t(`services.type.${item}`)}>
            {t(`services.type.${item}`)}
          </SelectItem>
        ))
      }
    </SelectContent>
  </Select>

  <span
    class="absolute bottom-0 left-0 -mb-[2lh] h-[2lh] text-xs text-red-500"
    data-error="userServiceCategory"></span>
</div>
