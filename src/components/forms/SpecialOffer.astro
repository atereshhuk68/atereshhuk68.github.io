---
import UserName from "@/components/forms/fields/UserName.astro";
import UserPhone from "@/components/forms/fields/UserPhone.astro";
import { Button } from "@/components/starwind/button";
import { useTranslations } from "@/lib/handle-ui-translations";
import { type Locales } from "@/types";
import UserServiceCategory from "./fields/UserServiceCategory.astro";
import {
  Dialog,
  DialogTrigger,
  DialogContent,
  DialogClose,
} from "@/components/starwind/dialog";

const { currentLocale = "pl" } = Astro;

const t = useTranslations(currentLocale as Locales);
---

<Dialog data-close-special-offer>
  <DialogTrigger asChild>
    <button
      class="bg-golden-200 hover:bg-golden-300 fixed bottom-4 left-4 z-50 size-12 cursor-pointer rounded-full shadow-lg transition-transform hover:scale-110"
      data-open-special-dialog
      aria-label="Open Special Offer"
    >
      <span class="pointer-events-none">🔥</span>
    </button>
  </DialogTrigger>

  <DialogContent id="specialOfferDialog" class="p-5 md:p-6">
    <div class="prose md:prose-lg">
      <div class="font-heading text-center text-2xl md:text-3xl">
        {t("specialOffer.heading")}
      </div>

      <p class="grid place-items-center text-center">
        <span class="block">{t("specialOffer.p1")}</span>
        <span class="bg-cove-600 block rounded-sm px-4 font-bold text-white"
          >{t("specialOffer.p2")}</span
        >
      </p>

      <p class="text-center text-base">{t("specialOffer.cta")}</p>

      <form
        class="mx-auto grid max-w-lg space-y-6 min-[450px]:place-items-center"
        method="post"
        data-special-offer-form
      >
        <input type="hidden" name="formTitle" value="offer" />

        <UserName />

        <UserPhone />

        <UserServiceCategory />

        <div class="mb-0 grid gap-4">
          <Button
            size="lg"
            variant="secondary"
            class="min-w-50 disabled:opacity-50"
            type="submit"
          >
            {t("specialOffer.submitText")}
          </Button>

          <DialogClose asChild>
            <Button size="sm" variant="ghost" class="min-w-50" type="button">
              {t("specialOffer.later")}
            </Button>
          </DialogClose>
        </div>
      </form>
    </div>
  </DialogContent>
</Dialog>

<script>
  import { getCookie, setCookie } from "typescript-cookie";
  import {
    resetFormErrors,
    clearInputError,
    renderFieldErrors,
  } from "@/lib/handle-errors";
  import {
    setSubmitButtonDisabled,
    setSubmitButtonEnabled,
  } from "@/lib/handle-submit-button";
  import { validateFormBySchema } from "@/lib/handle-form-validation";
  import { SPECIAL_OFFER_COOKIE_NAME } from "../../constants";
  import { toggleDialog } from "@/lib/handle-dialogs";
  import { postFormPayload } from "@/lib/handle-form-submit";
  import { getOfferFormSchema } from "@/schemas/forms";
  import type { Locales } from "@/types";

  const currentLocale = (document.body.dataset.currentLocale ||
    "pl") as Locales;
  const offerFormSchema = getOfferFormSchema(currentLocale);

  const specialOfferDialogModule = (() => {
    const SELECTORS = {
      specialOfferTrigger: "[data-open-special-dialog]",
      specialOfferDialog: "#specialOfferDialog",
      specialOfferForm: "form[data-special-offer-form]",
      specialOfferFormFields:
        "form[data-special-offer-form] input, form[data-special-offer-form] textarea, form[data-special-offer-form] select",
      closeSpecialOfferDialogButtons: "[data-close-special-offer]",
      errorDialog: "#errorModal",
      successDialog: "#successModal",
    };

    const ELEMENTS = {
      specialOfferTrigger: document.querySelector<HTMLButtonElement>(
        SELECTORS.specialOfferTrigger,
      ),
      specialOfferDialog: document.querySelector<HTMLDialogElement>(
        SELECTORS.specialOfferDialog,
      )!,
      specialOfferForm: document.querySelector<HTMLFormElement>(
        SELECTORS.specialOfferForm,
      ),
      specialOfferFormFields: document.querySelectorAll<HTMLInputElement>(
        SELECTORS.specialOfferFormFields,
      ),
      closeSpecialOfferDialogButtons:
        document.querySelectorAll<HTMLButtonElement>(
          SELECTORS.closeSpecialOfferDialogButtons,
        ),
      errorDialog: document.querySelector<HTMLDialogElement>(
        SELECTORS.errorDialog,
      ),
      successDialog: document.querySelector<HTMLDialogElement>(
        SELECTORS.successDialog,
      ),
    };

    const isUserSawOffer = getCookie(SPECIAL_OFFER_COOKIE_NAME);

    const handleSubmit = async (event: SubmitEvent) => {
      event.preventDefault();

      const submittedForm = event.currentTarget as HTMLFormElement;
      const submitButton = event.submitter as HTMLButtonElement;

      resetFormErrors(submittedForm);

      const {
        success: validationSuccess,
        data,
        error: validationErrors,
      } = validateFormBySchema(submittedForm, offerFormSchema);

      if (!validationSuccess) {
        const errors = validationErrors.flatten().fieldErrors;

        renderFieldErrors(submittedForm, errors);

        return;
      }

      setSubmitButtonDisabled(submitButton);

      const { success } = await postFormPayload(data);

      if (success) {
        if (ELEMENTS.successDialog) {
          toggleDialog(ELEMENTS.specialOfferDialog, false);
          toggleDialog(ELEMENTS.successDialog, true);
          submittedForm.reset();

          setCookie(SPECIAL_OFFER_COOKIE_NAME, "true", {
            expires: 365,
            path: "/",
            sameSite: "None",
            secure: true,
          });
        }
      } else {
        if (ELEMENTS.errorDialog) {
          toggleDialog(ELEMENTS.errorDialog, true);
        }
      }

      setSubmitButtonEnabled(submitButton);
    };

    const setEventListeners = () => {
      ELEMENTS.specialOfferForm?.addEventListener("submit", handleSubmit);

      window.addEventListener("load", () => {
        if (!isUserSawOffer) {
          setTimeout(() => {
            // add dispatch event to trigger dialog open with starwind dialog trigger
            ELEMENTS.specialOfferTrigger?.dispatchEvent(
              new MouseEvent("click", { bubbles: true }),
            );
          }, 2500);
        }
      });

      if (ELEMENTS.specialOfferFormFields) {
        for (const formField of ELEMENTS.specialOfferFormFields) {
          formField.addEventListener("input", (event) => {
            const field = event.currentTarget as HTMLInputElement;

            clearInputError(field);
          });

          formField.addEventListener("starwind-select:change", (event) => {
            const field = event.currentTarget as HTMLInputElement;

            clearInputError(field);
          });
        }
      }

      if (ELEMENTS.closeSpecialOfferDialogButtons) {
        for (const closeDialogButton of ELEMENTS.closeSpecialOfferDialogButtons) {
          closeDialogButton.addEventListener("click", (event) => {
            setCookie(SPECIAL_OFFER_COOKIE_NAME, "true", {
              expires: 365,
              path: "/",
              sameSite: "None",
              secure: true,
            });
          });
        }
      }
    };

    return {
      init: () => {
        setEventListeners();
      },
    };
  })();

  specialOfferDialogModule.init();
</script>
