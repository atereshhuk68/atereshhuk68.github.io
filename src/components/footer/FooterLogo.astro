---
import { Image } from "astro:assets";
import Logo from "@/assets/images/vector/logo/footer-logo-w160.svg";
import { DEFAULT_LANG } from "@/constants/langs";

const { currentLocale } = Astro;

const homePageUrl = currentLocale === DEFAULT_LANG ? "/" : `/${currentLocale}/`;

const isHomepage = Astro.url.pathname === homePageUrl;

const Comp = isHomepage ? "div" : "a";
const CompProps = isHomepage
	? {}
	: { href: "/", "aria-label": "Go to homepage" };
---

<div class="flex lg:justify-center flex-grow order-first lg:order-[initial]">
	<Comp class={`inline-flex w-[120px] h-auto aspect-[${Logo.width}/${Logo.height}]`} {...CompProps}>
		<Image src={Logo} alt="BFancy Footer Logo" class="inline-flex size-full" width={Logo.width} height={Logo.height} />
	</Comp>
</div>
