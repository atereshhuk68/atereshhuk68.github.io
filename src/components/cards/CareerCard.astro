---
import { Briefcase, MapPin } from "@lucide/astro";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types";
import type { InferEntrySchema } from "astro:content";
import Badge from "@/components/starwind/badge";

type JobProps = InferEntrySchema<"jobs">;

const { currentLocale = "pl" } = Astro;
const t = useTranslations(currentLocale as Locales);

interface Props extends Pick<
  JobProps,
  "title" | "country" | "city" | "slug" | "isJobActive"
> {}

const { title, country, city, slug, isJobActive } = Astro.props;
---

<div class="grid gap-3 rounded-2xl bg-white p-4 shadow-2xs">
  <header class="grid grid-cols-[max-content_1fr] items-start gap-3">
    <Briefcase size={24} />

    <div class="grid content-start gap-1">
      <p class="text-md font-medium">{title}</p>
      <div class="text-small text-default-500 flex items-center gap-1">
        <MapPin size={16} />

        <span class="text-sm">{country}, {city}</span>
      </div>
    </div>
  </header>

  <div class="flex items-center justify-between gap-2">
    {
      isJobActive ? (
        <Badge variant="success">{t("career.positiveStatus")}</Badge>
      ) : (
        <Badge variant="outline">{t("career.negativeStatus")}</Badge>
      )
    }

    {
      isJobActive && (
        <a
          class="text-cove-600 hover:text-cove-600/75 text-sm"
          href={`${slug}/`}
        >
          <span>{t("career.more")}</span>
        </a>
      )
    }
  </div>
</div>
