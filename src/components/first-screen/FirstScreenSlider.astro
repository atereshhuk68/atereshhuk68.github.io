---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types";

const examplesImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/pixel/examples/*.webp",
  { eager: true },
);

const images = Object.values(examplesImages).map((mod) => mod.default);

const { currentLocale = "pl" } = Astro;
const t = useTranslations(currentLocale as Locales);
---

<div class="overflow-hidden rounded-2xl" style="grid-area: slider;">
  <div class="embla" data-slider="hero-slider">
    <div class="embla__viewport">
      <div class="embla__container">
        {
          images.map((image, i) => (
            <div class="embla__slide">
              <a
                class="flex h-full w-full md:aspect-video xl:aspect-square"
                href={image.src}
                data-pswp-width={image.width / 2}
                data-pswp-height={image.height / 2}
                target="_blank"
              >
                <Image
                  class="h-full w-full rounded-4xl object-cover object-center"
                  src={image}
                  alt={`${t("imageAlt")} ${++i}`}
                  height={image.height / 2}
                  width={image.width / 2}
                  format="avif"
                  quality={"high"}
                />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";
  import EmblaCarousel, { type EmblaOptionsType } from "embla-carousel";

  const SLIDER_SELECTOR = '.embla[data-slider="hero-slider"]';
  const VIEWPORT_SELECTOR = `${SLIDER_SELECTOR} .embla__viewport`;

  const emblaNode = document.querySelector<HTMLElement>(VIEWPORT_SELECTOR);

  const emblaOptions: EmblaOptionsType = {
    loop: true,
    align: "center",
    breakpoints: { "(min-width: 1280px)": { align: "start" } },
  };

  if (emblaNode) {
    EmblaCarousel(emblaNode, emblaOptions);
  }

  const lightbox = new PhotoSwipeLightbox({
    gallery: SLIDER_SELECTOR,
    children: `${SLIDER_SELECTOR} a`,
    pswpModule: () => import("photoswipe"),

    loop: false,
    clickToCloseNonZoomable: false,
  });

  lightbox.init();
</script>
