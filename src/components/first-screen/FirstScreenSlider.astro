---
import type { ImageMetadata } from "astro";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types/locales";
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from "@/components/starwind/carousel";
import { Image } from "@/components/starwind/image";

type CustomImageMetadata = ImageMetadata & {
  priority?: boolean;
};

const firstScreenSliderImages = import.meta.glob<{
  default: CustomImageMetadata;
}>("/src/assets/images/pixel/2026/*.webp", { eager: true });

const images = Object.values(firstScreenSliderImages).map((mod) => mod.default);

/* Set priority for the first two images and the last image */
images[0].priority = true;
images[1].priority = true;
images[images.length - 1].priority = true;

const { currentLocale = "pl" } = Astro;
const t = useTranslations(currentLocale as Locales);
---

<Carousel
  opts={{ align: "start", loop: true }}
  data-slider="hero-slider"
  class="flex min-w-0 flex-col gap-4"
  style="grid-area: slider;"
>
  <CarouselContent class="lg:h-full">
    {
      images.map((image, index) => (
        <CarouselItem class="basis-[320px] md:basis-1/2 lg:basis-118.75 xl:basis-122.5">
          <a
            class="clip-reveal inline-flex aspect-square w-full overflow-hidden rounded-2xl lg:h-full"
            href={image.src}
            data-pswp-width={image.width / 2}
            data-pswp-height={image.height / 2}
            target="_blank"
          >
            <Image
              class="size-full object-cover object-center"
              src={image}
              alt={`${t("imageAlt")} ${++index}`}
              height={image.height / 2}
              width={image.width / 2}
              format="webp"
              quality={"mid"}
              fetchpriority={image.priority ? "high" : "auto"}
              loading={image.priority ? "eager" : "lazy"}
            />
          </a>
        </CarouselItem>
      ))
    }
  </CarouselContent>
  <div class="flex flex-row-reverse items-center gap-4">
    <CarouselNext size="lg" variant="primary" class="w-full" />
    <CarouselPrevious size="lg" variant="primary" class="w-full" />
  </div>
</Carousel>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import { initClipReveal } from "@/lib/clip-reveal";
  // oxlint-disable-next-line import/no-unassigned-import
  import "photoswipe/style.css";

  const SLIDER_SELECTOR = '[data-slider="hero-slider"]';

  initClipReveal(SLIDER_SELECTOR, 100);
  document.addEventListener("astro:after-swap", () =>
    initClipReveal(SLIDER_SELECTOR, 100),
  );

  const lightbox = new PhotoSwipeLightbox({
    gallery: SLIDER_SELECTOR,
    children: `${SLIDER_SELECTOR} a`,
    pswpModule: () => import("photoswipe"),

    loop: false,
    clickToCloseNonZoomable: false,
  });

  lightbox.init();
</script>
