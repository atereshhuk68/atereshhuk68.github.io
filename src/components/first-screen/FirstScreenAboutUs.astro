---
import { useTranslations } from '@/lib/handle-ui-translations';
import type { Locales } from '@/types';
import { ExternalLink } from '@lucide/astro';

const { currentLocale = 'pl' } = Astro;
const t = useTranslations(currentLocale as Locales);

const { class: className = '' } = Astro.props;
---

<div class={`bg-cove-600/20 rounded-3xl px-4 py-6 md:p-8 space-y-4 ${className}`} style="grid-area: aboutus">
	<h2 class="text-4xl lg:text-5xl font-heading text-balance">
		{t('about.h2')}
	</h2>

	<p class="text-base md:text-lg">
		{t('about.p1')}
	</p>

	<p class="text-base md:text-lg">
		{t('about.p2')}
	</p>

	<p class="text-base md:text-lg">
		<a
			class="text-black-900 underline hover:no-underline font-semibold cursor-pointer inline-flex gap-1 items-center"
			href="https://www.instagram.com/bfancy.warsaw"
			rel="noopener"
			target="_blank">
			<span>
				{t('about.instagram')}
			</span>

			<ExternalLink size={20} stroke-width={2} />
		</a>
	</p>

	<hr />

	<p class="text-base md:text-lg">{t('about.other')}</p>

	<ul class="custom-list space-y-4">
		<li>
			<a
				href="https://www.facebook.com/share/18dnZPTrj1/?mibextid=wwXIfr"
				class="text-black-900 underline hover:no-underline font-bold cursor-pointer transition-[color] duration-200"
				target="_blank"
				rel="noopener">
				Facebook
			</a>
		</li>
		<li>
			<a
				href="https://t.me/bfancy_warsaw"
				class="text-black-900 underline hover:no-underline font-bold cursor-pointer transition-[color] duration-200"
				target="_blank"
				rel="noopener">
				Telegram
			</a>
		</li>
		<li>
			<a
				href="https://api.whatsapp.com/send/?phone=48690647476&type=phone_number&app_absent=0"
				class="text-black-900 underline hover:no-underline font-bold cursor-pointer transition-[color] duration-200"
				target="_blank"
				rel="noopener">Whatsapp</a
			>
		</li>
		<li>
			<a
				href="viber://chat?number=48690647476"
				class="text-black-900 underline hover:no-underline font-bold cursor-pointer transition-[color] duration-200"
				target="_blank"
				rel="noopener">Viber</a
			>
		</li>
	</ul>
</div>
