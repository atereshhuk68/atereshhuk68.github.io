---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types";

const examplesImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/pixel/persons/*.webp",
  { eager: true },
);

const images = Object.values(examplesImages).map((mod) => mod.default);

const { currentLocale = "pl" } = Astro;
const t = useTranslations(currentLocale as Locales);
---

<div
  class="embla"
  data-slider="about-us-slider"
  style="grid-area: aboutusslider"
>
  <div class="embla__viewport">
    <div class="embla__container">
      {
        images.map((image, i) => (
          <div class="embla__slide">
            <a
              class="flex size-full"
              href={image.src}
              data-pswp-width={image.width / 2}
              data-pswp-height={image.height / 2}
              target="_blank"
            >
              <Image
                class="size-full rounded-4xl object-cover object-center lg:object-top"
                src={image}
                alt={`${t("imageAlt")} ${++i}`}
                height={image.height / 3}
                width={image.width / 3}
                format="avif"
                quality={"high"}
              />
            </a>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";
  import EmblaCarousel, { type EmblaOptionsType } from "embla-carousel";

  const SLIDER_SELECTOR = '.embla[data-slider="about-us-slider"]';
  const VIEWPORT_SELECTOR = `${SLIDER_SELECTOR} .embla__viewport`;

  const isMobile = window.matchMedia("(max-width: 768px)").matches;

  const desktopOptions: EmblaOptionsType = { axis: "y", loop: true };
  const mobileOptions: EmblaOptionsType = { loop: true, align: "center" };

  const sliderNodeOptions: EmblaOptionsType = isMobile
    ? mobileOptions
    : desktopOptions;
  const sliderNode = document.querySelector<HTMLElement>(VIEWPORT_SELECTOR);

  if (sliderNode) {
    EmblaCarousel(sliderNode, sliderNodeOptions);
  }

  const lightbox = new PhotoSwipeLightbox({
    gallery: SLIDER_SELECTOR,
    children: `${SLIDER_SELECTOR} a`,
    pswpModule: () => import("photoswipe"),

    loop: false,
    clickToCloseNonZoomable: false,
  });

  lightbox.init();
</script>
