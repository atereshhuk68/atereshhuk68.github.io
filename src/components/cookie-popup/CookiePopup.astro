---
import { Button } from "@/components/starwind/button";
import { useTranslations } from "@/lib/handle-ui-translations";
import type { Locales } from "@/types";

const { currentLocale = "pl" } = Astro;

const t = useTranslations(currentLocale as Locales);
---

<div
  class="pointer-events-none fixed bottom-0 left-0 flex w-full justify-center p-4"
>
  <div
    id="cookiePopup"
    class="grid max-w-[400px] place-items-center gap-4 rounded-xl bg-white p-4 text-center shadow-2xl"
    style="transform: scale(0.4); opacity: 0;"
  >
    <p class="text-black-900 text-sm text-pretty">
      {t("cookie.p")}
    </p>

    <Button
      id="cookiePopupButton"
      variant="primary"
      size="sm"
      class="pointer-events-auto"
    >
      <span class="font-medium">{t("cookie.cta")}</span>
    </Button>
  </div>
</div>

<script>
  import { getCookie, setCookie } from "typescript-cookie";
  import { COOKIE_NAME, CUBIC_BEZIER_BOUNCE } from "@/constants";

  const cookiePopup = document.querySelector<HTMLDivElement>("#cookiePopup");
  const cookieButton =
    document.querySelector<HTMLButtonElement>("#cookiePopupButton");

  const abortController = new AbortController();
  const { signal } = abortController;

  const saveCookie = (name: string, value: boolean): void => {
    try {
      setCookie(name, String(value), {
        expires: 365,
        path: "/",
        sameSite: "None",
        secure: true,
      });
    } catch (error) {
      // eslint-disable-next-line no-console
      console.error("🚨 Failed to save cookie:", error);
    }
  };

  const handleClosePopup = (): void => {
    if (cookiePopup) {
      const keyframes: Keyframe[] = [
        { transform: "scale(1)", opacity: 1 },
        { transform: "scale(0.4)", opacity: 0 },
      ];

      const options: KeyframeAnimationOptions = {
        duration: 500,
        easing: CUBIC_BEZIER_BOUNCE,
        fill: "forwards",
      };

      cookiePopup.animate(keyframes, options);
    }

    saveCookie(COOKIE_NAME, true);

    abortController.abort();
  };

  const setEventListeners = (): void => {
    cookieButton?.addEventListener("click", () => handleClosePopup(), {
      signal,
    });
  };

  const displayPopup = () => {
    if (cookiePopup) {
      const keyframes: Keyframe[] = [
        { transform: "scale(0.4)", opacity: 0 },
        { transform: "scale(1)", opacity: 1 },
      ];

      const options: KeyframeAnimationOptions = {
        duration: 500,
        easing: CUBIC_BEZIER_BOUNCE,
        fill: "forwards",
      };

      cookiePopup.animate(keyframes, options);
    }
  };

  const preparePopup = (): void => {
    if (getCookie(COOKIE_NAME)) return;

    if (cookiePopup) {
      displayPopup();
    }
  };

  const init = () => {
    if (cookiePopup) {
      preparePopup();
      setEventListeners();
    }
  };

  init();
</script>
