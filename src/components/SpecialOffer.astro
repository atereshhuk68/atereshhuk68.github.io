---
import { Button } from '@heroui/react';
import { useTranslations } from '@i18n/utils';
import { X } from 'lucide-react';
import type { Locales } from 'src/types';
import UserName from './sections/Contact/fields/UserName.astro';
import UserPhone from './sections/Contact/fields/UserPhone.astro';

const { currentLocale = 'pl' } = Astro;

const t = useTranslations(currentLocale as Locales);
---

<button
	class="fixed bottom-4 left-4 z-50 bg-golden-200 size-12 rounded-full shadow-lg hover:bg-golden-300 cursor-pointer hover:scale-110 transition-transform"
	data-open-special-dialog
	aria-label="Open Special Offer">
	<span class="pointer-events-none">🔥</span>
</button>

<dialog
	id="specialOfferDialog"
	class="m-auto w-[90%] max-w-[544px] space-y-8 rounded-lg bg-white p-4 md:px-8 md:pb-10 md:pt-8 text-black-800 shadow-card outline-none backdrop:bg-black-900/60"
	style="transform: scale(0.4); opacity: 0;">
	<div class="prose md:prose-lg mb-0">
		<div class="font-heading text-2xl md:text-3xl text-center">
			{t('specialOffer.heading')}
		</div>

		<p>{t('specialOffer.p1')}</p>

		<ul class="custom-list not-prose">
			<li>{t('specialOffer.listItem1')}</li>
			<li>{t('specialOffer.listItem2')}</li>
			<li>{t('specialOffer.listItem3')}</li>
		</ul>

		<p>{t('specialOffer.cta')}</p>

		<form class="grid place-items-center space-y-8 max-w-[512px] mx-auto" method="post" data-special-offer-form>
			<UserName />

			<UserPhone />

			<div class="grid gap-4 mb-0">
				<Button size="lg" className="bg-golden-200 text-black-900 inline-flex gap-2 items-center font-medium disabled:opacity-50 min-w-[200px] peer" type="submit" client:load>
					{t('specialOffer.submitText')}
				</Button>

				<Button size="md" variant="flat" className="text-black-900 inline-flex gap-2 items-center font-medium min-w-[200px] peer" type="button" data-close-special-offer>
					{t('specialOffer.later')}
				</Button>
			</div>
		</form>

		<small class="block text-center text-black-700 text-sm mt-10">{t('specialOffer.note')}</small>
	</div>

	<button
		aria-label="Close special offer modal"
		class="cursor-pointer absolute top-4 right-4 text-black-900 hover:text-black-500 focus:outline-none transition-colors"
		data-close-special-offer>
		<X />
	</button>
</dialog>

<script>
	import { getCookie, setCookie } from 'typescript-cookie';
	import { clearErrors, clearFieldError, displayErrors } from '../utils/handle-errors';
	import { enableSubmitButton, disableSubmitButton } from '../utils/handle-submit-button';
	import { validateFormBySchema } from '../utils/handle-form-validation';
	import { isDev } from '../../constants';
	import { toggleDialog } from 'src/utils/handle-dialogs';
	import { sendForm } from 'src/utils/handle-form-submit';
	import { offerFormSchema } from 'src/schemas';

	const FETCH_URL = isDev ? 'http://localhost:8000/offer.php' : '/offer.php';

	const specialOfferDialogModule = (() => {
		const specialOfferTrigger = document.querySelector<HTMLButtonElement>('[data-open-special-dialog]');
		const specialOfferDialog = document.querySelector<HTMLDialogElement>('#specialOfferDialog')!;
		const specialOfferForm = document.querySelector<HTMLFormElement>('form[data-special-offer-form]');
		const specialOfferFormFields = specialOfferForm?.querySelectorAll<HTMLInputElement>('input, textarea');
		const closeSpecialOfferDialogButtons = document.querySelectorAll<HTMLButtonElement>('[data-close-special-offer]');
		const errorDialog = document.querySelector<HTMLDialogElement>('#errorModal');
		const successDialog = document.querySelector<HTMLDialogElement>('#successModal');

		const COOKIE_NAME = 'specialOffer' as const;

		const isUserSawOffer = getCookie(COOKIE_NAME);

		const handleSubmit = async (event: SubmitEvent) => {
			event.preventDefault();

			const submittedForm = event.currentTarget as HTMLFormElement;
			const submitButton = event.submitter as HTMLButtonElement;

			clearErrors(submittedForm);

			const { success: validationSuccess, data, error: validationErrors } = validateFormBySchema(submittedForm, offerFormSchema);

			if (!validationSuccess) {
				const errors = validationErrors.flatten().fieldErrors;

				displayErrors(submittedForm, errors);

				return;
			}

			disableSubmitButton(submitButton);

			const { success } = await sendForm(FETCH_URL, data);

			if (success) {
				if (successDialog) {
					toggleDialog(specialOfferDialog, false);
					toggleDialog(successDialog, true);
					submittedForm.reset();

					setCookie(COOKIE_NAME, 'true', {
						expires: 365,
						path: '/',
						sameSite: 'None',
						secure: true,
					});
				}
			} else {
				if (errorDialog) {
					toggleDialog(errorDialog, true);
				}
			}

			enableSubmitButton(submitButton);
		};

		const setEventListeners = () => {
			specialOfferForm?.addEventListener('submit', handleSubmit);

			window.addEventListener('load', () => {
				if (!isUserSawOffer) {
					setTimeout(() => {
						toggleDialog(specialOfferDialog, true);
					}, 2000);
				}
			});

			document.addEventListener('keydown', (event) => {
				if (!specialOfferDialog) return;

				if (event.key === 'Escape' && specialOfferDialog.open) {
					toggleDialog(specialOfferDialog, false);
				}
			});

			specialOfferTrigger?.addEventListener('click', () => {
				toggleDialog(specialOfferDialog, true);
			});

			if (specialOfferFormFields) {
				for (const formField of specialOfferFormFields) {
					formField.addEventListener('input', (event) => {
						const field = event.currentTarget as HTMLInputElement;

						clearFieldError(field);
					});
				}
			}

			if (closeSpecialOfferDialogButtons) {
				for (const closeDialogButton of closeSpecialOfferDialogButtons) {
					closeDialogButton.addEventListener('click', (event) => {
						toggleDialog(specialOfferDialog, false);

						setCookie('specialOffer', 'true', {
							expires: 365,
							path: '/',
							sameSite: 'None',
							secure: true,
						});
					});
				}
			}
		};

		return {
			init: () => {
				setEventListeners();
			},
		};
	})();

	specialOfferDialogModule.init();
</script>
