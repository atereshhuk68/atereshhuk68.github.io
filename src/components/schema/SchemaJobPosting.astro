---
import { CompanyDefaultData } from "@/constants";
import type { InferEntrySchema } from "astro:content";

type JobPostSchema = InferEntrySchema<"jobs">;

interface Props extends Omit<JobPostSchema, "slug" | "isJobActive"> {}

const {
  title,
  metaDescription: description,
  city,
  country,
  publishedDate,
} = Astro.props;

const validThroughDate = new Date();
validThroughDate.setFullYear(validThroughDate.getFullYear() + 5);
const validThrough = validThroughDate.toISOString();

const jobPostingSchema = {
  "@context": "https://schema.org/",
  "@type": "JobPosting",
  title: title,
  description: description,
  datePosted: publishedDate,
  validThrough: validThrough,
  employmentType: "FULL_TIME",
  hiringOrganization: {
    "@type": "Organization",
    name: CompanyDefaultData.organizationName,
    sameAs: CompanyDefaultData.organizationUrl,
  },
  jobLocation: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      postalCode: CompanyDefaultData.postalCode,
      addressLocality: city,
      streetAddress: CompanyDefaultData.street,
      addressRegion: CompanyDefaultData.region,
      addressCountry: country,
    },
  },
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(jobPostingSchema)}
/>
