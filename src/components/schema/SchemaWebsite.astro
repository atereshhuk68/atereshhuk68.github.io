---
import { SITE } from '@/constants';

interface Props {
	name: string;
	description: string;
}

const { name, description } = Astro.props;

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: name,
	url: SITE,
	description: description,
	inLanguage: ['pl', 'en', 'uk', 'ru'],
	publisher: {
		'@type': 'Organization',
		name: name,
		logo: {
			'@type': 'ImageObject',
			url: `${SITE}/bfancy-logo-w220.svg`,
		},
		sameAs: [
			'https://www.instagram.com/bfancy.warsaw',
			'https://www.facebook.com/share/18dnZPTrj1/?mibextid=wwXIfr',
			'https://t.me/bfancy_warsaw',
			'https://api.whatsapp.com/send/?phone=48690647476&type=phone_number&app_absent=0',
			'viber://chat?number=48690647476',
		],
	},
};
---

<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
