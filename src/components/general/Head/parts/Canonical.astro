---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { LanguagesList } from '@i18n/langs';
import { getTranslatedURL } from '@i18n/utils';
import { SITE } from 'consts';
import type { Locales } from 'src/types';

const {
	url: { pathname },
	currentLocale = 'pl',
} = Astro;

const basePath = getTranslatedURL(pathname, currentLocale as Locales);

const canonicalUrl = SITE + pathname;

const alternates = LanguagesList.map(({ locale }) => {
	const altHref = getRelativeLocaleUrl(locale, basePath);
	const absHref = SITE + altHref;
	return { locale, absHref };
});
---

<link rel="canonical" href={canonicalUrl} />
{alternates.map(({ locale, absHref }) => <link rel="alternate" hreflang={locale} href={absHref} />)}
<link rel="alternate" hreflang="x-default" href={SITE + getRelativeLocaleUrl('pl', basePath)} />
