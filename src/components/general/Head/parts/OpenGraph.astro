---
import { SITE } from "consts";

const { title, description } = Astro.props;
const currentPathname = Astro.url.pathname;
const ogUrl = `${SITE}${currentPathname}`;
const currentLocale = Astro.props.currentLocale;
---

<meta property="og:url" content={ogUrl} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content="/og-bfancy-image.jpg" />
<meta property="og:locale" content={currentLocale} />
<meta property="og:site_name" content="BFancy" />

<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content="/og-bfancy-image.jpg" />
