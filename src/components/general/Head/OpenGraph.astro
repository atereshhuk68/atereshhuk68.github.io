---
import { browserLocales } from '@i18n/langs';
import { getLangFromUrl } from '@i18n/utils';
import { SITE } from 'consts';

const { title, description } = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const currentPathname = Astro.url.pathname;

const ogUrl = `${SITE}${currentPathname}`;

const locale = browserLocales[currentLang] || 'en_US';
---

<meta property="og:url" content={ogUrl} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content="/og-bfancy-image.jpg" />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content="BFancy" />

<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content="/og-bfancy-image.jpg" />
