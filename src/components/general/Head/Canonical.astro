---
import { SITE } from 'consts';
import { LanguagesList } from '@i18n/langs';
import { getLangFromUrl } from '@i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const currentLang = getLangFromUrl(Astro.url);
const currentPathname = Astro.url.pathname;

const canonicalUrl = SITE + (currentLang === 'pl' ? currentPathname : currentPathname);

const alternates = LanguagesList.map(({ locale }) => {
	const altHref = getRelativeLocaleUrl(locale, currentPathname);
	const absHref = SITE + altHref;
	return { locale, absHref };
});
---

<link rel="canonical" href={canonicalUrl} />
{alternates.map(({ locale, absHref }) => <link rel="alternate" hreflang={locale} href={absHref} />)}
<link rel="alternate" hreflang="x-default" href={SITE + getRelativeLocaleUrl('pl', currentPathname)} />
