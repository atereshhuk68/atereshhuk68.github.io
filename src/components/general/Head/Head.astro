---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Ahrefs from "./parts/Ahrefs.astro";
import Canonical from "./parts/Canonical.astro";
import Clarity from "./parts/Clarity.astro";
import Favicons from "./parts/Favicons.astro";
import GTM from "./parts/GTM.astro";
import OpenGraph from "./parts/OpenGraph.astro";

const { title, description } = Astro.props;
const isDev = import.meta.env.MODE === "development";
---

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<Favicons />
	<Canonical />
	<title>{title}</title>
	<meta name="description" content={description} />
	<OpenGraph {title} {description} />
	<ClientRouter fallback="none" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	{!isDev && (
		<GTM />
		<Ahrefs />
		<Clarity />
	)}

	<Font cssVariable='--font-inter' preload />

	<style>
		body {
				font-family: var(--font-inter);
		}
	</style>
</head>
