---
import { Button } from '@heroui/react';
import { HeaderLangs } from './components/HeaderLangs.tsx';
import HeaderLogo from './components/HeaderLogo.astro';
import { HeaderMenu } from './components/HeaderMenu.tsx';
import { Calendar, Minus } from '@lucide/astro';

import { getTranslatedURL, useTranslations } from '@i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { LanguagesList, defaultLang } from '@i18n/langs';

const {
	url: { pathname },
	currentLocale = 'pl',
} = Astro;

const t = useTranslations(currentLocale);

const basePath = getTranslatedURL(pathname, currentLocale);

const modifyUrl = (anchor: string) => {
	if (currentLocale !== defaultLang) {
		return `/${currentLocale}/${anchor}`;
	}

	return `/${anchor}`;
};

const menuItems = [
	{ href: modifyUrl('#services'), label: t('header.nav.services') },
	{ href: modifyUrl('#aboutUs'), label: t('header.nav.aboutUs') },
	{ href: getRelativeLocaleUrl(currentLocale, 'careers'), label: t('header.nav.careers') },
];

const ModifiedLanguagesList = LanguagesList.map(({ locale, name }) => ({
	locale,
	name,
	href: getRelativeLocaleUrl(locale, basePath),
}));
---

<header class="py-8">
	<div class="container">
		<div class="flex items-center justify-between">
			<HeaderMenu menuItems={menuItems} className="lg:w-[350px] order-last lg:order-[initial] min-w-10" client:load />

			<HeaderLogo class="flex-grow lg:flex-grow-0" />

			<div class="items-center justify-end md:w-[350px] contents lg:flex">
				<Button variant="bordered" size="lg" radius="sm" className="text-cove-700 border-cove-700 inline-flex sm:hidden" isIconOnly client:load>
					<a class="size-12 items-center justify-center inline-flex" href="https://booksy.com/pl-pl/dl/show-business/296324" target="_blank" rel="noopener">
						<Calendar size={24} />
					</a>
				</Button>

				<Button variant="bordered" size="lg" radius="sm" className="font-medium text-cove-700 border-cove-700 border-[2px] hidden sm:inline-flex px-0" client:load>
					<a class="inline-flex items-center h-12 px-8" href="https://booksy.com/pl-pl/dl/show-business/296324" target="_blank" rel="noopener">
						<span>{t('header.cta.appointment')}</span>
					</a>
				</Button>

				<Minus stroke-width={1} size={32} class="rotate-90 opacity-25" />

				<HeaderLangs items={ModifiedLanguagesList} client:load />

				<Minus stroke-width={1} size={32} class="rotate-90 opacity-25 lg:hidden" />
			</div>
		</div>
	</div>
</header>
