---
import { Button } from '@heroui/react';
import { HeaderLangs } from './components/HeaderLangs.tsx';
import HeaderLogo from './components/HeaderLogo.astro';
import { HeaderMenu } from './components/HeaderMenu.tsx';
import { VerticalSeparator } from '@components/icons/VerticalSeparator';
import { Calendar } from 'lucide-react';

import { getLangFromUrl, getTranslatedURL, useTranslations } from '@i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLang } from '@i18n/langs';

const currentLang = getLangFromUrl(Astro.url);
const currentPathname = Astro.url.pathname;
const t = useTranslations(currentLang);

const basePath = getTranslatedURL(currentLang, currentPathname);

const modifyUrl = (anchor: string) => {
	if (currentLang !== defaultLang) {
		return `/${currentLang}/${anchor}`;
	}

	return `/${anchor}`;
};

const menuItems = [
	{ href: modifyUrl('#services'), label: t('header.nav.services') },
	{ href: modifyUrl('#aboutUs'), label: t('header.nav.aboutUs') },
	{ href: getRelativeLocaleUrl(currentLang, 'careers'), label: t('header.nav.careers') },
];
---

<header class="py-8">
	<div class="container">
		<div class="flex items-center justify-between sm:gap-1">
			<HeaderMenu menuItems={menuItems} className="lg:w-[350px] order-last lg:order-[initial]" client:load />

			<HeaderLogo class="flex-grow lg:flex-grow-0" />

			<div class="items-center sm:gap-4 justify-end md:w-[350px] contents lg:flex">
				<Button variant="bordered" size="lg" radius="sm" className="text-cove-700 border-cove-700 inline-flex sm:hidden" isIconOnly client:load>
					<Calendar size={24} />
				</Button>

				<Button variant="bordered" size="lg" radius="sm" className="font-medium text-cove-700 border-cove-700 border-[2px] hidden sm:inline-flex" client:load>
					<span>{t('header.cta.appointment')}</span>
				</Button>

				<VerticalSeparator client:load />

				<HeaderLangs client:load />

				<VerticalSeparator className="lg:hidden" client:load />
			</div>
		</div>
	</div>
</header>
