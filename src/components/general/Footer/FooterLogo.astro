---
import Logo from '@assets/logo/footer-logo-w160.svg';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { defaultLang } from '@i18n/langs';
import cx from 'classix';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const mainLogoAspectRatioClass = `aspect-[${Logo.width}/${Logo.height}]`;

const homePageUrl = lang === defaultLang ? '/' : `/${lang}/`;

const isHomepage = Astro.url.pathname === homePageUrl;

const Comp = isHomepage ? 'div' : 'a';
const CompProps = isHomepage ? {} : { href: '/', 'aria-label': 'Go to homepage' };
---

<div class="flex lg:justify-center flex-grow order-first lg:order-[initial]">
	<Comp class={cx(mainLogoAspectRatioClass, 'w-[120px] h-auto')} {...CompProps}>
		<Image src={Logo} alt="BFancy Footer Logo" class="inline-flex size-full" width={Logo.width} height={Logo.height} />
	</Comp>
</div>
