---
import Logo from '@assets/logo/footer-logo-w160.svg';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { defaultLang } from '@i18n/langs';
import cx from 'classix';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const mainLogoAspectRatioClass = `${Logo.width}/${Logo.height}`;

const homePageUrl = lang === defaultLang ? '/' : `/${lang}/`;

const isHomepage = Astro.url.pathname === homePageUrl;

const Comp = isHomepage ? 'div' : 'a';
---

<div class="flex lg:justify-center flex-grow order-first lg:order-[initial]">
	<Comp class="aspect-[160/155] w-[120px] h-auto">
		<Image src={Logo} alt="BFancy Footer Logo" class={cx(mainLogoAspectRatioClass, 'w-[180px] xl:w-[220px] h-auto')} width={Logo.width} height={Logo.height} />
	</Comp>
</div>
