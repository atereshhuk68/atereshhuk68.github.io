---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { LanguagesList } from '@i18n/langs';
import { getLangFromUrl, getTranslatedURL } from '@i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const currentPathname = Astro.url.pathname;

const basePath = getTranslatedURL(currentLang, currentPathname);
---

<ul class="flex items-center gap-4 lg:w-[280px] text-sm">
	{
		LanguagesList.map(({ locale, name }) => (
			<li>
				{locale === currentLang ? (
					<span class="text-cove-700 pointer-events-none">{name}</span>
				) : (
					<a href={getRelativeLocaleUrl(locale, basePath)} class="text-black-900 hover:text-cove-600 transition-[color] duration-200">
						{name}
					</a>
				)}
			</li>
		))
	}
</ul>
